#!/usr/bin/env bash
set -euo pipefail

# Collect staged Dart files (excluding deleted files).
dart_files=$(git diff --cached --name-only --diff-filter=d -- '*.dart')

if [[ -z "$dart_files" ]]; then
  exit 0
fi

# 1. Format staged Dart files and re-stage any changes.
echo "$dart_files" | xargs dart format
echo "$dart_files" | xargs git add

# 2. Analyze staged Dart files — block the commit on any issues.
if ! echo "$dart_files" | xargs dart analyze --fatal-infos; then
  echo ""
  echo "dart analyze found issues — commit blocked. Fix them and try again."
  exit 1
fi
